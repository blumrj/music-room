DATABASE_URL="postgresql://music_room:music_room@localhost:5432/music_room"
PORT=8888

# Used only by prisma/seed.js to create the one admin user (Phase 6).
ADMIN_EMAIL=admin@music-room.local
ADMIN_PASSWORD=change-me

# Newsletter (Phase 8). Without RESEND_API_KEY, emails are logged to the
# console instead of sent — useful for local dev before a Resend account
# exists.
APP_BASE_URL=http://localhost:8888
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
